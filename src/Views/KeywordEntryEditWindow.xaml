<Window x:Class="Flow.Launcher.Plugin.AliasFlow.Views.KeywordEntryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource EntryWindow_Title}"
        Width="720"
        Height="560"
        MinWidth="660"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Title -->
                    <RowDefinition Height="10"/>

                    <RowDefinition Height="Auto"/>  <!-- Description -->
                    <RowDefinition Height="10"/>

                    <RowDefinition Height="Auto"/>  <!-- Target -->
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>  <!-- Target hint -->
                    <RowDefinition Height="12"/>

                    <RowDefinition Height="Auto"/>  <!-- Hotkey -->
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>  <!-- Hotkey hint -->
                    <RowDefinition Height="12"/>

                    <RowDefinition Height="Auto"/>  <!-- Keywords -->
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>  <!-- Keywords hint -->
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource EntryWindow_TitleLabel}"/>
                <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" Height="30"
                         ToolTip="{DynamicResource EntryWindow_TitleTooltip}"/>

                <!-- Description -->
                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource EntryWindow_DescriptionLabel}"/>
                <TextBox x:Name="DescBox" Grid.Row="2" Grid.Column="1" Height="30"
                         ToolTip="{DynamicResource EntryWindow_DescriptionTooltip}"/>

                <!-- Target -->
                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource EntryWindow_TargetLabel}"/>
                <TextBox x:Name="PathBox" Grid.Row="4" Grid.Column="1" Height="30"
                         ToolTip="{DynamicResource EntryWindow_TargetTooltip}"/>

                <TextBlock Grid.Row="6" Grid.Column="1" Opacity="0.75" TextWrapping="Wrap"
                           Text="{DynamicResource EntryWindow_TargetHint}"/>

                <!-- Hotkey -->
                <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource EntryWindow_HotkeyLabel}"/>
                <Grid Grid.Row="8" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="HotkeyBox" Grid.Column="0" Height="30"
                             VerticalContentAlignment="Center"
                             ToolTip="{DynamicResource EntryWindow_HotkeyTooltip}"/>

                    <Button Grid.Column="2"
                            Content="✕"
                            ToolTip="{DynamicResource EntryWindow_HotkeyClearTooltip}"
                            Click="HotkeyClearButton_Click"/>
                </Grid>

                <TextBlock Grid.Row="10" Grid.Column="1" Opacity="0.75" TextWrapping="Wrap"
                           Text="{DynamicResource EntryWindow_HotkeyHint}"/>

                <!-- Keywords -->
                <TextBlock Grid.Row="12" Grid.Column="0" VerticalAlignment="Top" Text="{DynamicResource EntryWindow_KeywordsLabel}"/>
                <TextBox x:Name="KeywordsBox"
                         Grid.Row="12" Grid.Column="1"
                         MinHeight="160"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         ToolTip="{DynamicResource EntryWindow_KeywordsTooltip}"/>

                <TextBlock Grid.Row="14" Grid.Column="1" Margin="0,6,0,0"
                           Opacity="0.75" TextWrapping="Wrap"
                           Text="{DynamicResource EntryWindow_KeywordsHint}"/>
            </Grid>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Width="92" Height="32" Margin="0,0,8,0" Content="{DynamicResource EntryWindow_CancelButton}" IsCancel="True"/>
            <Button Width="92" Height="32" Content="{DynamicResource EntryWindow_SaveButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
